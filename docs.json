{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "G Maps Crawl",
  "description": "Synchronous Google Maps business search: up to 20 businesses per request through REST, MCP, and agent skills.",
  "colors": {
    "primary": "#027B8B",
    "light": "#34ACBC",
    "dark": "#027B8B"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://gmapscrawl.com"
  },
  "api": {
    "openapi": "openapi.json",
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "python",
        "javascript"
      ]
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "introduction",
              "authentication",
              "quickstart",
              "concepts/availability"
            ]
          },
          {
            "group": "Core concepts",
            "pages": [
              "concepts/pagination",
              "concepts/idempotency",
              "concepts/usage",
              "concepts/errors"
            ]
          },
          {
            "group": "Workflows",
            "pages": [
              "guides/search"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "code",
        "groups": [
          {
            "group": "REST endpoints",
            "pages": [
              "api-reference/search"
            ]
          }
        ]
      },
      {
        "tab": "MCP & agents",
        "icon": "robot",
        "groups": [
          {
            "group": "Connect your agent",
            "pages": [
              "mcp/connect",
              "mcp/tools",
              "mcp/agent-skills"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/ricciflow-api/gmapscrawl-docs"
      },
      {
        "label": "Support",
        "href": "https://gmapscrawl.com/contact"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://gmapscrawl.com/dashboard"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/ricciflow-api/gmapscrawl-docs",
      "website": "https://gmapscrawl.com"
    }
  },
  "background": {
    "color": {
      "light": "#F8F8F4",
      "dark": "#0C0D0D"
    }
  }
}
